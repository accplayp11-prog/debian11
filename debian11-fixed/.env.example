# =============================================================================
# Debian Web Terminal — Environment Variables
# =============================================================================
# Copy to .env.local for local dev. Set all of these in Vercel project settings.
# NEVER commit .env.local to git.

# --- Turso (libSQL) Database ---
# From: https://app.turso.tech → Your Database → Settings
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# --- Initial Administrator Account ---
# Used ONCE to create the admin user. Set both in Vercel env vars.
INITIAL_ADMIN_USERNAME=yassine
INITIAL_ADMIN_PASSWORD=change-this-to-a-strong-password

# --- Session Security ---
# Generate: openssl rand -base64 64
SESSION_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars

# --- Debian Sandbox Root Password ---
DEBIAN_ROOT_PASSWORD=change-this-to-your-root-password

# --- Vercel Project (auto-set on Vercel, needed for local dev) ---
# From: cat .vercel/project.json  (after: vercel link)
VERCEL_OIDC_TOKEN=
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# --- Sandbox Configuration ---
# SANDBOX_NAME: unique name for your shared sandbox (per project)
SANDBOX_NAME=debian-shared-terminal

# SANDBOX_IMAGE: the VCR repository name pushed by the GitHub Actions workflow.
# Format options:
#   debian-11-terminal:latest                          ← short form (same project)
#   team-slug/project-slug/debian-11-terminal:latest   ← cross-project form
#   vcr.vercel.com/team/project/debian-11-terminal:latest ← fully qualified
#
# The GitHub Actions workflow pushes "debian-11-terminal:latest" by default.
# This MUST match exactly what was pushed and must show "Ready" in VCR dashboard.
SANDBOX_IMAGE=debian-11-terminal:latest
