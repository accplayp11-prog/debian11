# =============================================================================
# Debian Web Terminal — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# In production, configure these in Vercel project settings.
# NEVER commit .env.local or any file containing real secrets to Git.

# -----------------------------------------------------------------------------
# Turso (libSQL) Database
# -----------------------------------------------------------------------------
# Get these from: https://app.turso.tech → Your Database → Settings
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# -----------------------------------------------------------------------------
# Initial Administrator Account
# -----------------------------------------------------------------------------
# These are used ONCE at first startup to create the admin user in Turso.
# After the admin user is created, these can be removed (or left for reference).
INITIAL_ADMIN_USERNAME=yassine
INITIAL_ADMIN_PASSWORD=change-this-to-a-strong-password

# -----------------------------------------------------------------------------
# Session Security
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
# Must be at least 32 characters. Keep this secret.
SESSION_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars

# -----------------------------------------------------------------------------
# Debian Sandbox Root Password
# -----------------------------------------------------------------------------
# The root password set inside the Debian 11 Vercel Sandbox.
# This is used only during Sandbox initialization.
DEBIAN_ROOT_PASSWORD=change-this-to-your-root-password

# -----------------------------------------------------------------------------
# Vercel Project Authentication
# -----------------------------------------------------------------------------
# These are used to authenticate with Vercel Sandbox SDK.
# When deployed on Vercel, VERCEL_OIDC_TOKEN is set automatically.
# For local development, run: vercel link && vercel env pull
VERCEL_OIDC_TOKEN=
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# -----------------------------------------------------------------------------
# Sandbox Configuration
# -----------------------------------------------------------------------------
# The name of the shared persistent Debian sandbox (must be unique per project)
SANDBOX_NAME=debian-shared-terminal

# The custom Debian 11 image pushed to Vercel Container Registry
# Format: vcr.vercel.com/team-slug/project-slug/repository-name:tag
SANDBOX_IMAGE=debian-11-terminal:latest
